# Postgres connection string (Supabase, Neon, Railway or your own server)
DATABASE_URL=postgres://postgres:password@localhost:5432/pizzart
# Set to "true" when the database requires SSL (Supabase and Neon do)
DATABASE_SSL=false
# Long random string used to sign admin login sessions (e.g. `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string
# Master admin account (created on first setup; can manage all other accounts)
ADMIN_EMAIL=owner@pizzart.dz
ADMIN_PASSWORD=change-me
# Set to "true" once to reset the master admin's password to ADMIN_PASSWORD on the next build/setup
RESET_ADMIN_PASSWORD=false
# Optional: make another existing account the master admin instead of ADMIN_EMAIL
# MASTER_EMAIL=
